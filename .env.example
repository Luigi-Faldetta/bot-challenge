# Copy to .env.local (gitignored) and fill in real values.
# Validated at boot in src/shared/infrastructure/env.ts (added in a follow-up commit).

# Postgres — matches docker-compose.yml (port 5433 to avoid local 5432/54322 clashes)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/workfully_bot

# Anthropic — get a key at https://console.anthropic.com/settings/keys
# This value is server-side only. Never expose it to the browser.
ANTHROPIC_API_KEY=
